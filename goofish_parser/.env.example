TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_USER_ID=your_telegram_user_id_here
# CNY to RUB exchange rate (fallback if CBR is unreachable)
CNY_TO_RUB=12
# Vercel/Cloudflare proxy for Telegram API (optional, if api.telegram.org blocked)
# Example: https://goofish-proxy.vercel.app
API_BASE_URL=
# Proxy settings for Playwright (optional)
PROXY_HOST=
PROXY_USER=
PROXY_PASS=
