TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_USER_ID=your_telegram_user_id_here
# Exchange rate fallbacks (if CBR is unreachable)
KRW_TO_RUB=0.060
SGD_TO_RUB=60
JPY_TO_RUB=0.55
# Telegram API proxy pool (comma-separated). Bot auto-tests, picks fastest, fails over.
# Each proxy must serve Telegram Bot API at /api/bot{token}/...
# Example: https://goofish-proxy-1.vercel.app,https://goofish-proxy-2.vercel.app
TG_PROXY_POOL=

# Single proxy (fallback if pool not set)
API_BASE_URL=
