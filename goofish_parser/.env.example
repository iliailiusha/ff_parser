TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_USER_ID=your_telegram_user_id_here
# Exchange rate fallbacks (if CBR is unreachable)
KRW_TO_RUB=0.060
SGD_TO_RUB=60
JPY_TO_RUB=0.55
# Telegram API proxy pool. Bot auto-tests, picks fastest, fails over.
# Option A: single proxy via env var (comma-separated)
TG_PROXY_POOL=
# Option B: path to plain-text file with one proxy per line (# for comments)
TG_PROXY_FILE=
# How often to re-check all proxies (seconds)
TG_PROXY_CHECK_INTERVAL=300

# Single proxy (fallback if pool not set)
API_BASE_URL=
